{
  "expo": {
    "name": "yourGarage",
    "slug": "your-garage",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "yourgarage",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#171A20",
    "ios": {
      "bundleIdentifier": "dev.eslender.yourgarage",
      "icon": "./assets/expo.icon",
      "backgroundColor": "#171A20",
      "userInterfaceStyle": "dark"
    },
    "android": {
      "package": "dev.eslender.yourgarage",
      "backgroundColor": "#171A20",
      "userInterfaceStyle": "dark",
      "adaptiveIcon": {
        "backgroundColor": "#171A20",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-system-ui",
      [
        "expo-navigation-bar",
        {
          "style": "light",
          "enforceContrast": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#171A20",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-sqlite",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow access to your photo library to attach service receipts.",
          "cameraPermission": "Allow access to your camera to photograph service receipts.",
          "microphonePermission": false
        }
      ],
      "expo-sharing",
      "expo-asset",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#F59E0B"
        }
      ],
      [
        "react-native-ble-plx",
        {
          "isBackgroundEnabled": true,
          "modes": ["peripheral", "central"],
          "bluetoothAlwaysPermission": "Allow yourGarage to automatically sync mileage and diagnostics from your vehicle's OBD-II dongle."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
